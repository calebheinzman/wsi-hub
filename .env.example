# Copy to .env and fill in. Every key the code reads is listed here.

# LLMs (pipeline + live scorers)
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=        # optional: the run manifest reads the organization's costs (read-only admin key)
GEMINI_API_KEY=          # only with --gem
PERPLEXITY_API_KEY=      # only with --perplexity

# Search (1.1, 1.3, 1.6: Google Scholar via SerpAPI; 2.2: Serper)
SERPAPI_API_KEY=
SERPER_API_KEY=

# Open-access full text (free; without keys OpenAlex and Semantic Scholar answer 429)
OPENALEX_API_KEY=
OPENALEX_MAILTO=
S2_API_KEY=
UNPAYWALL_EMAIL=

# Supabase (push; see supabase/README.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=         # only for push --init-db-url / cleanup --tables
SUPABASE_PASSWORD=

# Frontend (frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
